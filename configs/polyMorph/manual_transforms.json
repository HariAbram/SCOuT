{
  "backend": "perf",
  "perf": {
    "events": [
      "cycles",
      "instructions"
    ],
    "core_list": "",
    "objective": {
      "metric": "CPI",
      "goal": "min"
    }
  },
  "objectives": [{"metric": "CPI", "goal": "min"}],
  "runs": 1,
  "polyMorph": {
    "project_root": "test-benchmarks/microSYCL",
    "source": "test-benchmarks/microSYCL/src/main.cpp",
    "compiler": "acpp",
    "flags": ["--acpp-platform=cpu", "--acpp-targets=generic", "-O3"],
    "transforms": [{"scop": 0, "node": 0, "tr": "FULL_SPLIT", "args": []}, {"scop": 0, "node": 1, "tr": "TILE_1D", "args": [16]}],
    "allow_illegal": true,
    "build_system": "make",
    "exec_name": "bin/main-acpp-generic",
    "generated_infix": "manual",
    "runtime_args": ["-s", "1024", "--gemm", "-i", "3"],
    "measure": true,
    "search": {
      "repeat": 2,
      "structural_retrieval": true,
      "search_strategy": "beam_optuna",
      "beam_width": 8,
      "beam_seed_trials": 8,
      "cache_evaluations": true,
      "multi_fidelity": true,
      "early_stop_worse_than": 1.15
    }
  }
}
