{
  "backend": "parser",
  "parser": {
    "label": "sum",
    "aggregate": "sum",
    "run_cwd": "binary_dir"
  },
  "objectives": [
    {
      "metric": "sycl_sum_sum_s",
      "goal": "min"
    }
  ],
  "runs": 1,
  "polyMorph": {
    "project_root": "test-benchmarks/polyMorph/O2/crossEntropy-sycl",
    "source": "test-benchmarks/polyMorph/O2/crossEntropy-sycl/main.cpp",
    "compiler": "acpp",
    "flags": [
      "-O2"
    ],
    "mcts_search": true,
    "build_system": "make",
    "exec_name": "build/crossEntropy-search",
    "runtime_args": [
      "10"
    ],
    "search": {
      "n_trials": 5,
      "repeat": 2,
      "seed": 42,
      "timeout": 1800,
      "max_transforms_per_trial": 3,
      "tile_sizes": [
        8,
        16,
        32,
        64,
        128
      ],
      "static_pruning": true,
      "analytical_model": true,
      "constraint_aware": true,
      "case_retrieval": true,
      "structural_retrieval": true,
      "cache_evaluations": true,
      "multi_fidelity": false,
      "early_stop_worse_than": 1.15,
      "cache_jsonl": "configs/polyMorph/O2/crossEntropy-sycl/o2-crossEntropy-cache.jsonl",
      "top_k": 50,
      "retrieval_top_k": 3,
      "backend_sensitivity_masks": [],
      "backend_sensitivity_repeat": 2,
      "backend_sensitivity_per_trial": false,
      "target_backend": "omp",
      "constraints": {
        "max_tile_size": 128,
        "max_tile_volume": 16384,
        "max_abs_shift": 16,
        "max_same_transform_per_sequence": 1,
        "preferred_tile_size": 32,
        "max_predicted_risk": 0.85,
        "backend_sensitivity_rel_threshold": 0.35,
        "performance_feedback_bias_weight": 0.35,
        "early_stop_warmup_runs": 1,
        "early_stop_measure_runs": 1,
        "tree_exploration": 1.2,
        "tree_family_novelty_bonus": 0.35,
        "tree_sequence_novelty_bonus": 0.1,
        "pluto_cost_model": true,
        "pluto_cost_weight": 1.0,
        "preferred_tile_size_fallback_weight": 0.0,
        "tree_tile_size_novelty_bonus": 0.35,
        "baseline_warmup_runs": 1,
        "pluto_stream_pair_weight": 0.15,
        "max_transforms_per_scop": 3,
        "sycl_kernel_scop_filter": true
      },
      "generated_infix": "crossEntropy",
      "baseline_exec_name": "build/crossEntropy-baseline",
      "history_jsonl": "configs/polyMorph/O2/crossEntropy-sycl/o2-crossEntropy-history.jsonl",
      "result_json": "configs/polyMorph/O2/crossEntropy-sycl/o2-crossEntropy-result.json",
      "trial_csv": "configs/polyMorph/O2/crossEntropy-sycl/o2-crossEntropy-trials.csv",
      "replay_top_k": 0,
      "final_validation_enabled": false,
      "final_validation_repeats": 3,
      "final_validation_warmup_runs": 1,
      "trial_warmup_runs": 1,
      "final_validation_top_k": 3,
      "final_validation_min_speedup": 1.0,
      "final_validation_noise_factor": 2.0,
      "baseline_resample_interval": 10
    }
  }
}
