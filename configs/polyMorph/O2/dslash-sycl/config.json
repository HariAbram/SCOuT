{
  "backend": "parser",
  "parser": {
    "label": "avg",
    "aggregate": "sum",
    "run_cwd": "binary_dir"
  },
  "objectives": [{"metric": "sycl_avg_sum_s", "goal": "min"}],
  "runs": 1,
  "polyMorph": {
    "project_root": "test-benchmarks/polyMorph/O2/dslash-sycl",
    "source": "test-benchmarks/polyMorph/O2/dslash-sycl/kernels.cpp",
    "compiler": "acpp",
    "flags": ["-O2"],
    "optuna_search": true,
    "build_system": "make",
    "exec_name": "build/dslash-search",
    "runtime_args": ["256"],
    "search": {
      "n_trials": 5,
      "repeat": 2,
      "seed": 42,
      "timeout": 600,
      "max_transforms_per_trial": 4,
      "tile_sizes": [8, 16, 32],
      "scale_factors": [2],
      "shift_values": [-1, 1],
      "static_pruning": true,
      "analytical_model": true,
      "constraint_aware": true,
      "compiler_feedback": true,
      "runtime_feedback": true,
      "case_retrieval": true,
      "structural_retrieval": true,
      "search_strategy": "beam_optuna",
      "beam_width": 8,
      "beam_seed_trials": 8,
      "cache_evaluations": true,
      "multi_fidelity": true,
      "early_stop_worse_than": 1.15,
      "cache_jsonl": "configs/polyMorph/O2/dslash-sycl/o2-dslash-cache.jsonl",
      "top_k": 100,
      "retrieval_top_k": 3,
      "compiler_feedback_flags": ["-Rpass=loop-vectorize", "-Rpass-missed=loop-vectorize"],
      "runtime_feedback_masks": ["omp"],
      "runtime_feedback_debug_level": 4,
      "runtime_feedback_repeat": 1,
      "constraints": {
        "max_tile_size": 128,
        "max_tile_volume": 16384,
        "max_abs_shift": 16,
        "max_same_transform_per_sequence": 1,
        "preferred_tile_size": 32,
        "max_predicted_risk": 0.85,
        "max_runtime_feedback_penalty": 0.9,
        "runtime_memcpy_per_kernel_threshold": 3.0,
        "runtime_backend_sensitivity_rel_threshold": 0.35,
        "runtime_feedback_bias_weight": 0.35
      },
      "explicit_args": {
        "TILE_2D": [[8, 8], [16, 16], [32, 32]],
        "FUSE": [[0, 1]],
        "SPLIT": [[2], [4], [8]],
        "PARTIAL_SHIFT_VAL": [[0, -1], [0, 1]],
        "FULL_SHIFT_VAR": [[0, -1], [0, 1], [1, -1], [1, 1]],
        "PARTIAL_SHIFT_VAR": [[0, 0, -1], [0, 0, 1]],
        "FULL_SHIFT_PARAM": [[0, -1], [0, 1], [1, -1], [1, 1]],
        "PARTIAL_SHIFT_PARAM": [[0, 0, -1], [0, 0, 1], [0, 1, -1], [0, 1, 1]]
      },
      "generated_infix": "dslash",
      "baseline_exec_name": "build/dslash-baseline",
      "history_jsonl": "configs/polyMorph/O2/dslash-sycl/o2-dslash-history.jsonl",
      "result_json": "configs/polyMorph/O2/dslash-sycl/o2-dslash-result.json",
      "trial_csv": "configs/polyMorph/O2/dslash-sycl/o2-dslash-trials.csv"
    }
  }
}
