{
  "backend": "parser",
  "parser": {
    "label": "avg",
    "aggregate": "sum",
    "run_cwd": "workdir"
  },
  "objectives": [{"metric": "sycl_avg_sum_s", "goal": "min"}],
  "runs": 1,
  "polyMorph": {
    "project_root": "test-benchmarks/polyMorph/O1/gmm-sycl",
    "source": "test-benchmarks/polyMorph/O1/gmm-sycl/main.cpp",
    "compiler": "acpp",
    "flags": ["-O1"],
    "optuna_search": true,
    "build_system": "make",
    "exec_name": "build/gmm-search",
    "runtime_args": ["500", "data", "result"],
    "search": {
      "n_trials": 5,
      "repeat": 2,
      "seed": 42,
      "timeout": 600,
      "max_transforms_per_trial": 1,
      "tile_sizes": [8, 16, 32],
      "scale_factors": [2],
      "shift_values": [-1, 1],
      "static_pruning": true,
      "analytical_model": true,
      "constraint_aware": true,
      "compiler_feedback": true,
      "runtime_feedback": true,
      "case_retrieval": true,
      "structural_retrieval": true,
      "cache_evaluations": true,
      "multi_fidelity": false,
      "early_stop_worse_than": 1.15,
      "cache_jsonl": "configs/polyMorph/O1/gmm-sycl/o1-gmm-cache.jsonl",
      "top_k": 100,
      "retrieval_top_k": 3,
      "compiler_feedback_flags": ["-Rpass=loop-vectorize", "-Rpass-missed=loop-vectorize"],
      "runtime_feedback_masks": ["omp", "ocl"],
      "runtime_feedback_debug_level": 4,
      "runtime_feedback_repeat": 2,
      "target_backend": "omp",
      "constraints": {
        "max_tile_size": 128,
        "max_tile_volume": 16384,
        "max_abs_shift": 16,
        "max_same_transform_per_sequence": 1,
        "max_transforms_per_scop": 1,
        "preferred_tile_size": 32,
        "max_predicted_risk": 0.85,
        "max_runtime_feedback_penalty": 0.9,
        "runtime_memcpy_per_kernel_threshold": 3.0,
        "runtime_backend_sensitivity_rel_threshold": 0.35,
        "runtime_feedback_bias_weight": 0.35,
        "early_stop_warmup_runs": 1,
        "early_stop_measure_runs": 1
      },
      "generated_infix": "gmm",
      "baseline_exec_name": "build/gmm-baseline",
      "history_jsonl": "configs/polyMorph/O1/gmm-sycl/o1-gmm-history.jsonl",
      "result_json": "configs/polyMorph/O1/gmm-sycl/o1-gmm-result.json",
      "trial_csv": "configs/polyMorph/O1/gmm-sycl/o1-gmm-trials.csv"
    }
  }
}
