{
  "backend": "parser",
  "parser": {
    "label": "avg",
    "aggregate": "sum",
    "run_cwd": "binary_dir"
  },
  "objectives": [{"metric": "sycl_avg_sum_s", "goal": "min"}],
  "runs": 1,
  "polyMorph": {
    "project_root": "test-benchmarks/polyMorph/O1/matrixT-sycl",
    "source": "test-benchmarks/polyMorph/O1/matrixT-sycl/main.cpp",
    "compiler": "acpp",
    "flags": ["-O1"],
    "transforms": [],
    "allow_illegal": true,
    "build_system": "make",
    "exec_name": "build/matrixT-single-transform",
    "generated_infix": "matrixT-manual",
    "runtime_args": ["1024", "1024", "50"],
    "measure": false,
    "search": {
      "repeat": 1,
      "structural_retrieval": true,
      "search_strategy": "beam_optuna",
      "beam_width": 8,
      "beam_seed_trials": 8,
      "cache_evaluations": true,
      "multi_fidelity": true,
      "early_stop_worse_than": 1.15,
      "constraints": {
        "early_stop_warmup_runs": 1,
        "early_stop_measure_runs": 1
      }
    }
  }
}
