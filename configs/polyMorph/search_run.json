{
  "backend": "perf",
  "perf": {
    "events": ["cycles", "instructions"],
    "core_list": "",
    "objective": { "metric": "CPI", "goal": "min" }
  },
  "objectives": [
    { "metric": "CPI", "goal": "min" }
  ],
  "runs": 1,
  "polyMorph": {
    "project_root": "test-benchmarks/microSYCL",
    "source": "test-benchmarks/microSYCL/src/main.cpp",
    "compiler": "acpp",
    "flags": [
      "--acpp-platform=cpu",
      "--acpp-targets=generic",
      "-O3"
    ],
    "optuna_search": true,
    "build_system": "make",
    "exec_name": "bin/main-acpp-generic",
    "runtime_args": ["-s", "1024", "--gemm", "-i", "3"],
    "search": {
      "n_trials": 5,
      "repeat": 2,
      "generated_infix": "search",
      "seed": 42,
      "timeout": 600,
      "baseline_exec_name": "bin/main-acpp-generic-baseline",
      "max_transforms_per_trial": 2,
      "tile_sizes": [16, 32],
      "scale_factors": [2],
      "shift_values": [-1, 1],
      "result_json": "/tmp/scout-polymorph/search_result.json"
    }
  }
}
