{
  "backend": "perf",
  "perf": {
    "events": [
      "cycles",
      "instructions"
    ],
    "core_list": "",
    "objective": {
      "metric": "CPI",
      "goal": "min"
    }
  },
  "objectives": [{"metric": "CPI", "goal": "min"}, {"metric": "instructions", "goal": "min"}],
  "runs": 1,
  "polyMorph": {
    "project_root": "test-benchmarks/microSYCL",
    "source": "test-benchmarks/microSYCL/src/main.cpp",
    "compiler": "acpp",
    "flags": ["--acpp-platform=cpu", "--acpp-targets=generic", "-O3"],
    "optuna_search": true,
    "build_system": "make",
    "exec_name": "bin/main-acpp-generic",
    "runtime_args": ["-s", "1024", "--gemm", "-i", "3"],
    "search": {
      "n_trials": 8,
      "repeat": 2,
      "generated_infix": "search",
      "seed": 42,
      "timeout": 600,
      "baseline_exec_name": "bin/main-acpp-generic-baseline",
      "max_transforms_per_trial": 2,
      "tile_sizes": [8, 16, 32, 64],
      "scale_factors": [2],
      "shift_values": [-1, 1],
      "static_pruning": true,
      "analytical_model": true,
      "constraint_aware": true,
      "compiler_feedback": true,
      "runtime_feedback": false,
      "case_retrieval": true,
      "structural_retrieval": true,
      "search_strategy": "adaptive_tree",
      "cache_evaluations": true,
      "multi_fidelity": true,
      "early_stop_worse_than": 1.15,
      "cache_jsonl": "/tmp/scout-polymorph/history.cache.jsonl",
      "top_k": 20,
      "retrieval_top_k": 3,
      "history_jsonl": "/tmp/scout-polymorph/history.jsonl",
      "pareto_csv": "/tmp/scout-polymorph/pareto.csv",
      "result_json": "/tmp/scout-polymorph/result.json",
      "trial_csv": "/tmp/scout-polymorph/trials.csv",
      "compiler_feedback_flags": ["-Rpass=loop-vectorize", "-Rpass-missed=loop-vectorize"],
      "runtime_feedback_masks": ["omp", "ocl"],
      "runtime_feedback_debug_level": 4,
      "runtime_feedback_repeat": 2,
      "target_backend": "omp",
      "constraints": {
        "max_tile_size": 128,
        "max_tile_volume": 16384,
        "max_abs_shift": 16,
        "preferred_tile_size": 32,
        "max_predicted_risk": 0.85,
        "early_stop_warmup_runs": 1,
        "early_stop_measure_runs": 1
      }
    }
  }
}
