{
  "backend": "parser",
  "parser": {
    "label": "avg",
    "aggregate": "sum",
    "run_cwd": "binary_dir"
  },
  "objectives": [{"metric": "sycl_avg_sum_s", "goal": "min"}],
  "runs": 1,
  "polyMorph": {
    "project_root": "test-benchmarks/polyMorph/O1/matrixT-sycl",
    "source": "test-benchmarks/polyMorph/O1/matrixT-sycl/main.cpp",
    "compiler": "acpp",
    "flags": ["-O1"],
    "mcts_search": true,
    "build_system": "make",
    "exec_name": "build/matrixT-search",
    "runtime_args": ["8192", "8192", "50"],
    "search": {
      "n_trials": 5,
      "repeat": 2,
      "generated_infix": "matrixT",
      "seed": 42,
      "timeout": 600,
      "baseline_exec_name": "build/matrixT-baseline",
      "max_transforms_per_trial": 5,
      "tile_sizes": [8, 16, 32],
      "scale_factors": [2],
      "shift_values": [-1, 1],
      "result_json": "test-benchmarks/polyMorph/O1/matrixT-sycl/o1-matrixT-result.json",
      "trial_csv": "test-benchmarks/polyMorph/O1/matrixT-sycl/o1-matrixT-trials.csv",
      "structural_retrieval": true,
      "cache_evaluations": true,
      "multi_fidelity": true,
      "early_stop_worse_than": 1.15,
      "constraints": {
        "early_stop_warmup_runs": 1,
        "early_stop_measure_runs": 1
      },
      "cache_jsonl": "test-benchmarks/polyMorph/O1/matrixT-sycl/o1-matrixT-result.cache.jsonl",
      "ablation_enabled": false,
      "replay_top_k": 0
    }
  }
}
