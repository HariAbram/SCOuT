{
  "backend": "parser",
  "parser": {
    "label": "avg",
    "aggregate": "sum",
    "run_cwd": "binary_dir"
  },
  "objectives": [
    { "metric": "sycl_avg_sum_s", "goal": "min" }
  ],
  "runs": 1,
  "polyMorph": {
    "project_root": "test-benchmarks/polyMorph/O1/matrixT-sycl",
    "source": "test-benchmarks/polyMorph/O1/matrixT-sycl/main.cpp",
    "compiler": "acpp",
    "flags": [
      "-O1"
    ],
    "optuna_search": true,
    "build_system": "make",
    "exec_name": "build/matrixT-search",
    "runtime_args": ["1024", "1024", "50"],
    "search": {
      "n_trials": 6,
      "repeat": 2,
      "generated_infix": "matrixT",
      "seed": 42,
      "timeout": 600,
      "baseline_exec_name": "build/matrixT-baseline",
      "max_transforms_per_trial": 2,
      "tile_sizes": [8, 16, 32],
      "scale_factors": [2],
      "shift_values": [-1, 1],
      "explicit_args": {
        "TILE_2D": [[8, 8], [16, 16], [32, 32]],
        "FUSE": [[0, 1]],
        "SPLIT": [[2], [4], [8]],
        "PARTIAL_SHIFT_VAL": [[0, -1], [0, 1]],
        "FULL_SHIFT_VAR": [[0, -1], [0, 1], [1, -1], [1, 1]],
        "PARTIAL_SHIFT_VAR": [[0, 0, -1], [0, 0, 1]],
        "FULL_SHIFT_PARAM": [[0, -1], [0, 1], [1, -1], [1, 1]],
        "PARTIAL_SHIFT_PARAM": [[0, 0, -1], [0, 0, 1], [0, 1, -1], [0, 1, 1]],
        "SET_PARALLEL": [[2], [4], [8]]
      },
      "result_json": "test-benchmarks/polyMorph/O1/matrixT-sycl/o1-matrixT-result.json"
    }
  }
}
