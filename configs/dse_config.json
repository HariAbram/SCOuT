{
  "backend": "likwid",

  "project": {
    "dir": "/cephyr/users/hariv/Vera/SYCL-benchmarks/microSYCL",      
    "build_system": "make",    
    "target": "",
    "make_flags_var":"CXX_FLAGS",
    "make_vars": {                    
      "MY_DEFINE": "1"
    },
    "cmake_flag_vars": ["EXTRA_FLAGS", "CMAKE_CXX_FLAGS"]        
  },

  "source": "",                
  "compiler": "acpp",                      
  "output_basename": "", 
  "compiler_flags_base": "--acpp-platform=cpu --acpp-targets=generic", 
  
  "program_args": ["-s", "1024", "--gemm", "-i", "3"],

  "compiler_flags": [
        "-O2",
        "-O3"
    ],
  "compiler_flag_pool" :[
        "-mllvm -enable-loopinterchange -mllvm -enable-loop-distribute",
        "-mllvm -enable-interleaved-mem-accesses",
        "-fvectorize",
        "-mllvm --enable-vplan-native-path",
        "-ffast-math",
        "-funsafe-math-optimizations",
        "-mllvm -enable-misched"
    ],

  "compiler_params": {                
        "-march": ["native", "znver4", "skylake-avx512", "icelake-server"],

        "-mprefer-vector-width": [128, 256, 512],
        "-mllvm -force-vector-interleave": [2, 4, 8],

        "-mllvm -prefetch-distance":[4, 8, 16, 32, 64],
        "-mllvm -min-prefetch-stride":[1, 2, 4],

        "-flto": {                        
            "when": { "-Olevel": "3+" },    
            "values": [true, false]
        }
    },
    
  "compiler_params_select": {
      "min": 0,          
      "max": 5,          
      "always": ["-march"]   
	},

  "env": {
        "ACPP_VISIBILITY_MASK": ["omp", "ocl"],

        "OMP_PLACES": {
            "when"  : { "ACPP_VISIBILITY_MASK": "omp" },
            "values": ["sockets", "cores", "threads", "numa_domains"]
        },

        "OMP_SCHEDULE": {
            "when"  : { "ACPP_VISIBILITY_MASK": "omp" },
            "values": ["static", "dynamic"]
        },
        "DPCPP_CPU_PLACES":{
            "when"  : { "ACPP_VISIBILITY_MASK": "ocl" },
            "values": ["sockets", "cores", "threads", "numa_domains"]
        },

        "DPCPP_CPU_SCHEDULE":{
            "when"  : { "ACPP_VISIBILITY_MASK": "ocl" },
            "values": ["static", "dynamic"]
        }
    },

  "objectives": [
      {"metric": "CPI",    "goal": "min"},
      {"metric": "Runtime (RDTSC) [s]", "goal": "min"},
      {"metric": "Runtime unhalted [s]", "goal": "min"},
      {"metric": "Total_Vectorization", "goal": "max"},
      {"metric": "kernel_time_s", "goal": "min" }
    ],

  "search": { 
      "sampler": "tpe",
      "population_size": 64,     
      "random_seed": 42,
      "n_startup_trials" : 10,
      "study": "synergy"},

  "synergy": {
      "base_flags":"-O1",
      "flag_atoms": ["-funroll-loops","-fno-exceptions","-fno-rtti"],
      "eval_budget": 400,
      "strategy": "greedy",
      "ga_pop": 24,
      "ga_elite": 4,
      "ga_gens": 18,
      "ga_mut": 0.25,
      "max_seq_len": 12,
      "min_seq_len": 4,
      "epsilon": 0.0,
      "out_dir": "out/synergy_run"
  },

  "wavefront": {
      "flag_atoms": ["-funroll-loops", "-ffast-math", "-funsafe-math-optimizations", "-mllvm -enable-misched", "-mllvm -enable-interleaved-mem-accesses"],
      "base_flags": ["-O2"],
      "max_k": 3,
      "mode": "beam",
      "beam_width": 16,
      "per_wave_cap": null,
      "stop_if_no_improve": true,
      "improvement_eps": 0.0,
      "env": { },
      "env_mode": "product",
      "env_cap": 16
  },

  "jit_policy": {
    "mode": "isolate_then_adapt",
    "adaptivity_level": 1,
    "top_k": 5,
    "cache_root": "acpp_caches",
    "cuda_disable_cache_in_phase_a": false,
    "cache_home": "/cephyr/users/hariv/Vera/acpp_cache_home"
  },

  "likwid": {
      "group": "SCOuT", 
      "events":[], 
      "metrics":[{ "name": "CPI", "agg": "avg" ,"var":false}, 
                  { "name": "Runtime (RDTSC) [s]", "agg": "avg" ,"var":false},
                  { "name": "Runtime unhalted [s]", "agg": "avg" ,"var":false},
                  { "name": "Total_Vectorization", "agg": "avg" ,"var":false}], 
      "core_list": ""
    },

  "perf": {
      "events": ["cycles","instructions"],
      "core_list": "",
      "objective": {"metric": "CPI", "goal": "min"}
    },

  "parser": {
    "label": "avg",               
    "aggregate": "sum",            
    "core_list": "0-15",
    "run_cwd": "project_dir",
    "warmup_runs": 1 
  },

  "runs": 5,                                 
  "csv_log": "results.csv",
  "pareto_log": "pareto.csv",
  "failed_builds":"failed_builds.csv"            
}
