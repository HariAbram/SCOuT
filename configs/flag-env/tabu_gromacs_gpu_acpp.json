{
  "backend": "parser",
  "project": {
    "dir": "targets/gromacs",
    "build_system": "cmake",
    "target": "gmx",
    "executable": "bin/gmx",
    "cmake_flag_vars": ["CMAKE_CXX_FLAGS"],
    "cmake_defs": [
      "CMAKE_C_COMPILER=/usr/lib/llvm20/bin/clang",
      "GMX_SYCL=ACPP",
      "GMX_GPU=SYCL",
      "ACPP_TARGETS=cuda:sm_90",
      "GMX_BUILD_OWN_FFTW=ON",
      "REGRESSIONTEST_DOWNLOAD=ON",
      "BUILD_TESTING=OFF"
    ]
  },
  "compiler": "/usr/lib/llvm20/bin/clang++",
  "runtime_cache_policy": "reuse",
  "compiler_flags_base": "",
  "compiler_flags": [
    "-O2",
    "-O3"
  ],
  "compiler_flag_pool": [
    "-ffast-math",
    "-fno-math-errno",
    "-funroll-loops",
    "-fvectorize"
  ],
  "compiler_params": {
    "-march": ["native", "znver4"],
    "-mprefer-vector-width": [128, 256]
  },
  "compiler_params_select": {
    "min": 0,
    "max": 2,
    "always": []
  },
  "program_args": [
    "mdrun",
    "-s",
    "/cephyr/users/wincenth/Vera/ra/gromacs/SCOuT/ADH/adh_dodec/bench.tpr",
    "-deffnm",
    "scout_gpu_acpp",
    "-nsteps",
    "1000",
    "-ntmpi",
    "1",
    "-ntomp",
    "8",
    "-pin",
    "on",
    "-nb",
    "gpu",
    "-pme",
    "gpu",
    "-update",
    "gpu",
    "-bonded",
    "gpu"
  ],
  "env": {
    
  },
  "objectives": [
    { "metric": "gmx_ns_per_day", "goal": "max" }
  ],
  "search": {
    "study": "tabu",
    "random_seed": 17
  },
  "tabu": {
    "max_iters": 8,
    "max_no_improve": 5,
    "tabu_tenure": 8,
    "neighborhood": 4,
    "allow_variant_moves": true,
    "allow_param_moves": true,
    "allow_pool_moves": true,
    "allow_env_moves": true,
    "env_mode": "sample",
    "env_cap": 4,
    "results_csv": "./tabu_gpu_acpp.csv",
    "clean_run_outputs": true,
    "clean_globs": ["mdout.mdp"]
  },
  "parser": {
    "label": "sum",
    "aggregate": "sum",
    "run_cwd": "binary_dir",
    "warmup_runs": 2,
    "format": "gromacs"
  },
  "runs": 1,
  "csv_log": "./tabu_gpu_acpp_unused.csv",
  "failed_builds": "./tabu_gpu_acpp_failed.csv"
}
