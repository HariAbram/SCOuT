{
  "backend": "perf",
  "project": {
    "dir": "test-benchmarks/microSYCL",
    "build_system": "make",
    "target": "all",
    "make_flags_var": "EXTRA_CFLAGS",
    "make_vars": {
      "BACKEND": "generic",
      "DEBUG": "no",
      "OPTIMIZE": "yes"
    }
  },
  "compiler": "acpp",
  "compiler_flags_base": "--acpp-platform=cpu --acpp-targets=generic",
  "program_args": ["-s", "512", "--gemm", "-i", "2"],
  "compiler_flags": [
    "-O2"
  ],
  "compiler_flag_pool": [
    "-fvectorize",
    "-ffast-math",
    "-mllvm -enable-misched"
  ],
  "compiler_params": {},
  "compiler_params_select": {},
  "env": {
    "ACPP_VISIBILITY_MASK": ["omp", "generic"],
    "OMP_PLACES": {
      "when": { "ACPP_VISIBILITY_MASK": "omp" },
      "values": ["cores", "threads"]
    }
  },
  "objectives": [
    { "metric": "CPI", "goal": "min" }
  ],
  "search": {
    "study": "beam_tabu",
    "random_seed": 17
  },
  "significance": {
    "min_rel_gain": 0.10,
    "min_abs_gain": null
  },
  "beam_tabu": {
    "base_flags": ["-O2"],
    "flag_atoms": [
      "-fvectorize",
      "-ffast-math",
      "-mllvm -enable-misched"
    ],
    "max_k": 3,
    "beam_width": 8,
    "per_iter_cap": 10,
    "env_mode": "product",
    "env_cap": 3,
    "stop_if_no_improve": true,
    "improvement_eps": 0.0
  },
  "tabu": {
    "max_iters": 30,
    "max_no_improve": 8,
    "tabu_tenure": 10,
    "neighborhood": 12,
    "results_csv": "/tmp/scout-flag-env/beam_tabu_experimental.csv"
  },
  "perf": {
    "events": ["cycles", "instructions"],
    "core_list": "",
    "warmup_runs": 1,
    "objective": { "metric": "CPI", "goal": "min" }
  },
  "runs": 2,
  "csv_log": "/tmp/scout-flag-env/beam_tabu_unused.csv",
  "failed_builds": "/tmp/scout-flag-env/beam_tabu_failed.csv"
}
