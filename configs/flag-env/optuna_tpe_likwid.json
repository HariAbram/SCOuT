{
  "backend": "likwid",
  "project": {
    "dir": "test-benchmarks/microSYCL",
    "build_system": "make",
    "target": "all",
    "make_flags_var": "EXTRA_CFLAGS",
    "make_vars": {
      "BACKEND": "generic",
      "LIKWID": "yes",
      "DEBUG": "no",
      "OPTIMIZE": "yes"
    },
    "cmake_flag_vars": ["CMAKE_CXX_FLAGS"]
  },
  "compiler": "acpp",
  "compiler_flags_base": "--acpp-platform=cpu --acpp-targets=generic",
  "program_args": ["-s", "1024", "--gemm", "-i", "3"],
  "compiler_flags": [
    "-O2",
    "-O3",
    "-Ofast"
  ],
  "compiler_flag_pool": [
    "-fvectorize",
    "-ffast-math",
    "-funsafe-math-optimizations",
    "-mllvm -enable-interleaved-mem-accesses",
    "-mllvm -enable-misched"
  ],
  "compiler_params": {
    "-march": ["native", "znver4", "skylake-avx512"],
    "-mprefer-vector-width": [128, 256, 512],
    "-mllvm -force-vector-interleave": [2, 4, 8]
  },
  "compiler_params_select": {
    "min": 1,
    "max": 3,
    "always": ["-march"]
  },
  "env": {
    "ACPP_VISIBILITY_MASK": ["omp", "generic"],
    "OMP_PLACES": {
      "when": { "ACPP_VISIBILITY_MASK": "omp" },
      "values": ["cores", "threads"]
    },
    "OMP_SCHEDULE": {
      "when": { "ACPP_VISIBILITY_MASK": "omp" },
      "values": ["static", "dynamic"]
    }
  },
  "objectives": [
    { "metric": "CPI", "goal": "min" },
    { "metric": "Runtime (RDTSC) [s]", "goal": "min" },
    { "metric": "Total_Vectorization", "goal": "max" }
  ],
  "search": {
    "study": "optuna",
    "sampler": "tpe",
    "n_startup_trials": 10,
    "population_size": 32,
    "random_seed": 42
  },
  "likwid": {
    "group": "SCOuT",
    "events": [],
    "metrics": [
      { "name": "CPI", "agg": "avg", "var": false },
      { "name": "Runtime (RDTSC) [s]", "agg": "avg", "var": false },
      { "name": "Total_Vectorization", "agg": "avg", "var": false }
    ],
    "core_list": "",
    "warmup_runs": 1
  },
  "runs": 3,
  "csv_log": "/tmp/scout-flag-env/optuna_tpe_likwid.csv",
  "pareto_log": "/tmp/scout-flag-env/optuna_tpe_likwid_pareto.csv",
  "failed_builds": "/tmp/scout-flag-env/optuna_tpe_likwid_failed.csv"
}
