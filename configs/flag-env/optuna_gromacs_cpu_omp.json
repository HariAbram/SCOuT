{
  "backend": "parser",
  "project": {
    "dir": "/cephyr/users/wincenth/Vera/ra/gromacs/gromacs-2026.3",
    "build_system": "cmake",
    "target": "gmx",
    "executable": "bin/gmx",
    "build_jobs": 32,
    "cmake_flag_vars": ["CMAKE_CXX_FLAGS"],
    "cmake_defs": [
      "CMAKE_C_COMPILER=/apps/Arch/software/Clang/18.1.8-GCCcore-13.3.0/bin/clang",
      "CMAKE_CXX_COMPILER=/apps/Arch/software/Clang/18.1.8-GCCcore-13.3.0/bin/clang++",
      "GMX_GPU=OFF",
      "GMX_MPI=OFF",
      "GMX_BUILD_OWN_FFTW=ON",
      "REGRESSIONTEST_DOWNLOAD=ON",
      "BUILD_TESTING=OFF"
    ]
  },
  "compiler": "/apps/Arch/software/Clang/18.1.8-GCCcore-13.3.0/bin/clang++",
  "runtime_cache_policy": "reuse",
  "compiler_flags_base": "",
  "compiler_flags": [
    "-O2",
    "-O3"
  ],
  "compiler_flag_pool": [
    "-fno-math-errno",
    "-ffp-contract=fast",
    "-ffast-math",
    "-fvectorize",
    "-fno-vectorize",
    "-fslp-vectorize",
    "-fno-slp-vectorize",
    "-funroll-loops",
    "-fno-unroll-loops",
    "-fstrict-aliasing",
    "-fno-strict-aliasing",
    "-fmerge-all-constants",
    "-fno-merge-all-constants",
    "-fdelete-null-pointer-checks",
    "-fno-delete-null-pointer-checks",
    "-fexceptions",
    "-fno-exceptions",
    "-fno-rtti",
    "-mllvm -force-vector-interleave={2,4,8,16}",
    "-mllvm -enable-loopinterchange"
  ],
  "compiler_params": {
    "-march": ["native", "znver4"],
    "-mprefer-vector-width": [128, 256]
  },
  "compiler_params_select": {
    "min": 0,
    "max": 2,
    "always": []
  },
  "program_args": [
    "mdrun",
    "-s",
    "/cephyr/users/wincenth/Vera/ra/gromacs/SCOuT/runfiles/cubic.tpr",
    "-deffnm",
    "scout_cpu_omp",
    "-nsteps",
    "2000",
    "-ntmpi",
    "1",
    "-ntomp",
    "32",
    "-pin",
    "on",
    "-nb",
    "cpu",
    "-pme",
    "cpu",
    "-update",
    "cpu",
    "-bonded",
    "cpu"
  ],
  "env": {
    "OMP_PLACES": ["cores", "threads"],
    "OMP_PROC_BIND": ["close", "spread"],
    "OMP_SCHEDULE": ["static", "dynamic"]
  },
  "objectives": [
    { "metric": "gmx_ns_per_day", "goal": "max" }
  ],
  "search": {
    "study": "optuna",
    "sampler": "tpe",
    "n_startup_trials": 8,
    "random_seed": 13
  },
  "parser": {
    "label": "sum",
    "aggregate": "sum",
    "run_cwd": "binary_dir",
    "warmup_runs": 2,
    "format": "gromacs"
  },
  "runs": 1,
  "csv_log": "./optuna_gromacs_cpu_omp.csv",
  "failed_builds": "./optuna_gromacs_cpu_omp_failed.csv"
}
