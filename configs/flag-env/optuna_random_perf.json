{
  "backend": "perf",
  "project": {
    "dir": "test-benchmarks/microSYCL",
    "build_system": "make",
    "target": "all",
    "make_flags_var": "EXTRA_CFLAGS",
    "make_vars": {
      "BACKEND": "generic",
      "DEBUG": "no",
      "OPTIMIZE": "yes"
    }
  },
  "compiler": "acpp",
  "compiler_flags_base": "--acpp-platform=cpu --acpp-targets=generic",
  "program_args": ["-s", "512", "--gemm", "-i", "2"],
  "compiler_flags": [
    "-O2",
    "-O3"
  ],
  "compiler_flag_pool": [
    "-fvectorize",
    "-ffast-math",
    "-funsafe-math-optimizations"
  ],
  "compiler_params": {
    "-march": ["native", "znver4"],
    "-mprefer-vector-width": [128, 256]
  },
  "compiler_params_select": {
    "min": 0,
    "max": 2
  },
  "env": {
    "ACPP_VISIBILITY_MASK": ["omp", "generic"],
    "OMP_SCHEDULE": {
      "when": { "ACPP_VISIBILITY_MASK": "omp" },
      "values": ["static", "dynamic"]
    }
  },
  "objectives": [
    { "metric": "CPI", "goal": "min" }
  ],
  "search": {
    "study": "optuna",
    "sampler": "rs",
    "n_startup_trials": 5,
    "population_size": 16,
    "random_seed": 3
  },
  "perf": {
    "events": ["cycles", "instructions"],
    "core_list": "",
    "warmup_runs": 1,
    "objective": { "metric": "CPI", "goal": "min" }
  },
  "runs": 2,
  "csv_log": "/tmp/scout-flag-env/optuna_random_perf.csv",
  "failed_builds": "/tmp/scout-flag-env/optuna_random_perf_failed.csv"
}
