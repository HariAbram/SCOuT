{
  "backend": "parser",
  "parser": {
    "label": "sum",
    "aggregate": "sum",
    "run_cwd": "binary_dir"
  },
  "objectives": [
    {
      "metric": "sycl_sum_sum_s",
      "goal": "min"
    }
  ],
  "runs": 1,
  "polyMorph": {
    "project_root": "test-benchmarks/polyMorph/O1/matrixT-sycl",
    "source": "test-benchmarks/polyMorph/O1/matrixT-sycl/main.cpp",
    "compiler": "acpp",
    "flags": [
      "-O1"
    ],
    "mcts_search": true,
    "build_system": "make",
    "exec_name": "build/matrixT-search",
    "runtime_args": [
      "8192",
      "8192",
      "50"
    ],
    "search": {
      "n_trials": 5,
      "repeat": 2,
      "generated_infix": "matrixT",
      "seed": 42,
      "timeout": 600,
      "baseline_exec_name": "build/matrixT-baseline",
      "max_transforms_per_trial": 5,
      "tile_sizes": [
        8,
        16,
        32,
        64,
        128
      ],
      "static_pruning": true,
      "analytical_model": true,
      "constraint_aware": true,
      "case_retrieval": true,
      "structural_retrieval": true,
      "cache_evaluations": true,
      "multi_fidelity": false,
      "early_stop_worse_than": 1.15,
      "cache_jsonl": "test-benchmarks/polyMorph/O1/matrixT-sycl/o1-matrixT-cache.jsonl",
      "top_k": 100,
      "retrieval_top_k": 3,
      "history_jsonl": "test-benchmarks/polyMorph/O1/matrixT-sycl/o1-matrixT-history.jsonl",
      "backend_sensitivity_masks": [
        "omp",
        "ocl"
      ],
      "backend_sensitivity_repeat": 2,
      "backend_sensitivity_per_trial": false,
      "target_backend": "ocl",
      "constraints": {
        "max_tile_size": 128,
        "max_tile_volume": 16384,
        "max_abs_shift": 16,
        "max_same_transform_per_sequence": 1,
        "preferred_tile_size": 32,
        "max_predicted_risk": 0.85,
        "backend_sensitivity_rel_threshold": 0.35,
        "performance_feedback_bias_weight": 0.35,
        "early_stop_warmup_runs": 1,
        "early_stop_measure_runs": 1,
        "hot_kernel_filter": false,
        "hot_kernel_top_k": 3,
        "hot_kernel_min_fraction": 0.0,
        "hot_kernel_min_scops": 1,
        "hot_kernel_scop_mapping": "ordinal",
        "preferred_tile_size_fallback_weight": 0.0,
        "tree_tile_size_novelty_bonus": 0.35,
        "baseline_warmup_runs": 1,
        "compound_actions_enabled": true,
        "compound_beam_width": 20,
        "compound_beam_depth": 3,
        "compound_beam_measure_top_k": 10,
        "compound_beam_branching": 24,
        "pluto_stream_pair_weight": 0.15,
        "max_transforms_per_scop": 3
      },
      "result_json": "test-benchmarks/polyMorph/O1/matrixT-sycl/o1-matrixT-result.json",
      "trial_csv": "test-benchmarks/polyMorph/O1/matrixT-sycl/o1-matrixT-trials.csv",
      "ablation_enabled": false,
      "replay_top_k": 0,
      "trial_warmup_runs": 1
    }
  }
}
