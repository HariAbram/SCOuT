{
  "backend": "perf",
  "perf": {
    "events": [
      "cycles",
      "instructions"
    ],
    "core_list": "",
    "objective": {
      "metric": "CPI",
      "goal": "min"
    }
  },
  "objectives": [
    {
      "metric": "CPI",
      "goal": "min"
    }
  ],
  "runs": 1,
  "polyMorph": {
    "project_root": "test-benchmarks/microSYCL",
    "source": "test-benchmarks/microSYCL/src/main.cpp",
    "compiler": "acpp",
    "flags": [
      "--acpp-platform=cpu",
      "--acpp-targets=generic",
      "-O3"
    ],
    "mcts_search": true,
    "build_system": "make",
    "exec_name": "bin/main-acpp-generic",
    "runtime_args": [
      "-s",
      "1024",
      "--gemm",
      "-i",
      "3"
    ],
    "search": {
      "n_trials": 5,
      "repeat": 2,
      "generated_infix": "search",
      "seed": 42,
      "timeout": 600,
      "baseline_exec_name": "bin/main-acpp-generic-baseline",
      "max_transforms_per_trial": 5,
      "tile_sizes": [
        8,
        16,
        32,
        64,
        128
      ],
      "result_json": "/tmp/scout-polymorph/search_result.json",
      "structural_retrieval": true,
      "cache_evaluations": true,
      "multi_fidelity": false,
      "early_stop_worse_than": 1.15,
      "constraints": {
        "early_stop_warmup_runs": 1,
        "early_stop_measure_runs": 1,
        "preferred_tile_size_fallback_weight": 0.0,
        "tree_tile_size_novelty_bonus": 0.35,
        "baseline_warmup_runs": 1,
        "pluto_stream_pair_weight": 0.15,
        "max_transforms_per_scop": 3,
        "sycl_kernel_scop_filter": true
      },
      "cache_jsonl": "/tmp/scout-polymorph/search_result.cache.jsonl",
      "replay_top_k": 0,
      "trial_warmup_runs": 1,
      "target_backend": "omp",
      "backend_sensitivity_masks": []
    }
  }
}
