{
  "backend": "perf",
  "perf": {
    "events": [
      "cycles",
      "instructions"
    ],
    "core_list": "",
    "objective": {
      "metric": "CPI",
      "goal": "min"
    }
  },
  "objectives": [
    {
      "metric": "CPI",
      "goal": "min"
    },
    {
      "metric": "instructions",
      "goal": "min"
    }
  ],
  "runs": 1,
  "polyMorph": {
    "project_root": "test-benchmarks/microSYCL",
    "source": "test-benchmarks/microSYCL/src/main.cpp",
    "compiler": "acpp",
    "flags": [
      "--acpp-platform=cpu",
      "--acpp-targets=generic",
      "-O3"
    ],
    "mcts_search": true,
    "build_system": "make",
    "exec_name": "bin/main-acpp-generic",
    "runtime_args": [
      "-s",
      "1024",
      "--gemm",
      "-i",
      "3"
    ],
    "search": {
      "n_trials": 8,
      "repeat": 2,
      "generated_infix": "search",
      "seed": 42,
      "timeout": 600,
      "baseline_exec_name": "bin/main-acpp-generic-baseline",
      "max_transforms_per_trial": 5,
      "tile_sizes": [
        8,
        16,
        32,
        64,
        128
      ],
      "static_pruning": true,
      "analytical_model": true,
      "constraint_aware": true,
      "case_retrieval": true,
      "structural_retrieval": true,
      "cache_evaluations": true,
      "multi_fidelity": true,
      "early_stop_worse_than": 1.15,
      "cache_jsonl": "/tmp/scout-polymorph/history.cache.jsonl",
      "top_k": 20,
      "retrieval_top_k": 3,
      "history_jsonl": "/tmp/scout-polymorph/history.jsonl",
      "pareto_csv": "/tmp/scout-polymorph/pareto.csv",
      "result_json": "/tmp/scout-polymorph/result.json",
      "trial_csv": "/tmp/scout-polymorph/trials.csv",
      "backend_sensitivity_masks": [
        "omp",
        "ocl"
      ],
      "backend_sensitivity_repeat": 2,
      "backend_sensitivity_per_trial": false,
      "target_backend": "omp",
      "constraints": {
        "max_tile_size": 128,
        "max_tile_volume": 16384,
        "max_abs_shift": 16,
        "preferred_tile_size": 32,
        "max_predicted_risk": 0.85,
        "early_stop_warmup_runs": 1,
        "early_stop_measure_runs": 1,
        "hot_kernel_filter": false,
        "hot_kernel_top_k": 3,
        "hot_kernel_min_fraction": 0.0,
        "hot_kernel_min_scops": 1,
        "hot_kernel_scop_mapping": "ordinal",
        "preferred_tile_size_fallback_weight": 0.0,
        "tree_tile_size_novelty_bonus": 0.35,
        "baseline_warmup_runs": 1
      },
      "ablation_enabled": false,
      "replay_top_k": 0
    }
  }
}
